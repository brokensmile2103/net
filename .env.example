APP_NAME="Nét"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mam
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Đổi thành true NGAY KHI domain đã chạy HTTPS thật (bắt buộc cho production
# có người dùng thật) — cookie phiên đăng nhập chỉ được gửi qua kết nối mã
# hoá, chống bị đánh cắp qua mạng không an toàn (wifi công cộng...). Để false
# khi còn test trên http://localhost hoặc domain .test chưa có SSL.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Nét"

# Lấy tại https://resend.com/api-keys — KHÔNG commit key thật vào đây/vào git,
# chỉ điền trực tiếp vào file .env thật trên server.
RESEND_API_KEY=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Dung lượng ảnh (ảnh bìa + ảnh xem trước phương án, đã nén WebP) tối đa cho mỗi studio, đơn vị MB.
# NET_STORAGE_QUOTA_MB=500

# Đăng nhập bằng Google (tuỳ chọn) — tạo OAuth Client ở Google Cloud Console (loại "Web application"),
# Authorized redirect URI: https://example.com/auth/google/callback. Để trống CLIENT_ID thì nút Google tự ẩn.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Để trống = tự lấy theo tên miền đang truy cập (khuyến nghị). Chỉ điền khi cần cố định, VD: https://net.vn/auth/google/callback
GOOGLE_REDIRECT_URI=

# Website chạy sau Cloudflare / reverse proxy / load balancer → đặt TRUSTED_PROXIES=* để Laravel nhận đúng https
# (nếu không, Google báo redirect_uri_mismatch vì Nét gửi địa chỉ http://). Để trống nếu không dùng proxy.
TRUSTED_PROXIES=

# Tự chạy cập nhật database sau khi upload bản mới (không cần SSH). Đặt false nếu bạn tự chạy `php artisan migrate`.
NET_AUTO_MIGRATE=true

# Trợ lý AI: mỗi studio tự dán API key Gemini miễn phí trong Cài đặt — server không cần key nào.
# Mô hình MẶC ĐỊNH cho studio chưa tự chọn ở Cài đặt → Trợ lý AI (thử lần lượt, hết lượt / bị khai tử thì tự chuyển).
# NET_AI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
